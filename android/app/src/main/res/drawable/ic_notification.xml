<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar icon: the launcher mark alone, white on transparent as
     Android requires, cropped to the mark's 72x72 safe zone (translated by 18)
     so it fills the icon rather than sitting small in the middle of it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <group
        android:translateX="-18"
        android:translateY="-18">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M45.5,40 h8 a11,11 0 0 1 0,28 h-8 z" />
    </group>
</vector>
