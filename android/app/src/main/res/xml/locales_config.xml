<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's languages (#42), in AppLanguage.kt's own order. Required for
  AppCompatDelegate.setApplicationLocales to actually take effect on API 33+:
  without this, the platform LocaleManager has no declared list of supported
  locales to switch between, and the call is a silent no-op.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="af" />
    <locale android:name="en" />
</locale-config>
