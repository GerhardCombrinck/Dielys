<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DielysApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Dielys">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Dielys"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                A tapped invite link minted before this became an https App Link
                below (L3) — kept only so one already sent out still opens the app
                rather than a browser. Do not send new invites through this
                scheme; InviteLink.url() has not since the App Link was added.

                The link carries an invite token and nothing else. It is a bearer
                credential, so the app treats an arriving one as an offer to join,
                never as an instruction it acts on without the person seeing it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dielys" android:host="invite" />
            </intent-filter>

            <!--
                A tapped magic-link sign-in link (ADR 0005, docs/adr/0005-passwordless-email-magic-link.md)
                or a tapped invite link (L3, InviteLink). Both are https App
                Links rather than a custom scheme: an invite is shared through
                whatever the share sheet offers, email included, and several mail
                apps (Gmail's Android app among them) do not reliably let a
                person tap a custom-scheme link out of HTML mail. autoVerify asks
                Android to confirm ownership of dielys.com via the Worker's
                /.well-known/assetlinks.json before treating either path as an
                app link rather than a browser navigation — one verification
                covers both, since handle_all_urls in that file is domain-wide.

                Neither token needs protecting beyond what the server already
                enforces: a magic-link token is single-use and short-lived
                server-side (15 minutes, see UsersRoom.verifyMagicLink), and an
                invite token is scoped to one list and expires in 7 days (L3).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="dielys.com"
                    android:pathPrefix="/magic" />
                <data
                    android:scheme="https"
                    android:host="dielys.com"
                    android:pathPrefix="/invite" />
            </intent-filter>
        </activity>

        <!--
            The wake push (M1). Data-only and never displayed, so the service does
            nothing but ask for a sync; anything the user sees is read from Room
            afterwards. Not exported: only the Play services process delivers here.
        -->
        <service
            android:name=".data.push.DielysMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            WorkManager is configured by DielysApplication instead, so its worker
            factory comes from Hilt and the drain worker can reach the sync engine.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
