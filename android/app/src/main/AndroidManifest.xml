<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DielysApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Dielys">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Dielys"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                A tapped invite link (L3). A custom scheme rather than an https
                app link, which would need a verified domain and a page to serve
                it; the cost is that some chat apps will not make it tappable,
                which is why pasting one has to work too.

                The link carries an invite token and nothing else. It is a bearer
                credential, so the app treats an arriving one as an offer to join,
                never as an instruction it acts on without the person seeing it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dielys" android:host="invite" />
            </intent-filter>

            <!--
                A tapped magic-link sign-in link (ADR 0005, docs/adr/0005-passwordless-email-magic-link.md).
                An https App Link rather than a custom scheme, unlike the invite
                above: it arrives in an email, and several mail apps (Gmail's
                Android app among them) do not reliably let a person tap a
                custom-scheme link out of HTML mail. autoVerify asks Android to
                confirm ownership of dielys.com via the Worker's
                /.well-known/assetlinks.json before treating this as an app
                link rather than a browser navigation.

                The token is single-use and short-lived server-side (15 minutes) —
                see UsersRoom.verifyMagicLink — so there is nothing here to protect
                beyond what the server already enforces.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="dielys.com"
                    android:pathPrefix="/magic" />
            </intent-filter>
        </activity>

        <!--
            The wake push (M1). Data-only and never displayed, so the service does
            nothing but ask for a sync; anything the user sees is read from Room
            afterwards. Not exported: only the Play services process delivers here.
        -->
        <service
            android:name=".data.push.DielysMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            WorkManager is configured by DielysApplication instead, so its worker
            factory comes from Hilt and the drain worker can reach the sync engine.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
