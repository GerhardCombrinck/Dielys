{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dielys-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Migrations are imported as text so migrations/*.sql stays the one source
  // of truth (G1) rather than being duplicated as string literals in TS.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": {
    "ENVIRONMENT": "dev"
  },
  "durable_objects": {
    "bindings": [
      { "name": "LIST_ROOM", "class_name": "ListRoom" },
      { "name": "USERS_ROOM", "class_name": "UsersRoom" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ListRoom", "UsersRoom"]
    }
  ],
  "env": {
    "dev": {
      "name": "dielys-dev",
      "vars": { "ENVIRONMENT": "dev" },
      "durable_objects": {
        "bindings": [
          { "name": "LIST_ROOM", "class_name": "ListRoom" },
          { "name": "USERS_ROOM", "class_name": "UsersRoom" }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ListRoom", "UsersRoom"]
        }
      ]
    },
    "prod": {
      "name": "dielys-prod",
      "vars": { "ENVIRONMENT": "prod" },
      "durable_objects": {
        "bindings": [
          { "name": "LIST_ROOM", "class_name": "ListRoom" },
          { "name": "USERS_ROOM", "class_name": "UsersRoom" }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ListRoom", "UsersRoom"]
        }
      ]
    }
  }
}
